# ==============================================================
# Project S — .gitignore
# ==============================================================

# --- Claude Code (local instructions, do NOT push) ---
# Root project instructions only. memory-bank/ docs ARE pushed (see guard below).
/CLAUDE.md
.claude/

# Keep the memory-bank design docs tracked (guard against any future ignore rule)
!memory-bank/
!memory-bank/**

# ==============================================================
# Unity (based on the official GitHub Unity.gitignore)
# ==============================================================
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# ==============================================================
# OS / editor cruft
# ==============================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.vscode/
.idea/

# ==============================================================
# Apple Unity Plugins — auto-generated editor play-mode native libs
# Regenerated by Apple.Core when packages resolve; do not commit.
# (Must come after the !Assets/**/*.meta rule above so it wins.)
# ==============================================================
/Assets/Apple Plug-In Support/
/Assets/Apple Plug-In Support.meta

# ==============================================================
# Package Manager samples (de-risk artifacts, re-importable) — e.g. the 65MB PHASE Demo.
# Re-import anytime via Package Manager > <package> > Samples.
# ==============================================================
/Assets/Samples/
/Assets/Samples.meta

# ==============================================================
# Trial art. Loafbrr was dropped (owner disliked it) — stays ignored.
# ==============================================================
/Assets/LoafbrrAssets/
/Assets/LoafbrrAssets.meta

# PSXBackrooms is now the chosen art → COMMITTED (7.5 MB, with .meta for stable GUIDs) so teammates get the
# dressed level 1:1. Only the heavy Blender source files stay out (Unity doesn't need them; they'd force a
# Blender install to import).
/Assets/PSXBackrooms/Blender/
/Assets/PSXBackrooms/Blender.meta

# ==============================================================
# Ghost monster — unused Mixamo turn animations. Kept locally but NOT committed
# (the AnimatorController only uses Idle/Walking/Zombie Attack) → saves ~48 MB.
# ==============================================================
/Assets/Ghost/Left Turn 90.fbx
/Assets/Ghost/Left Turn 90.fbx.meta
/Assets/Ghost/Right Turn.fbx
/Assets/Ghost/Right Turn.fbx.meta

# ==============================================================
# Audio: radio.wav deferred (41 MB, not wired yet) — keep local, commit later if used.
# ==============================================================
/Assets/_Project/Audio/TIER 2/radio.wav
/Assets/_Project/Audio/TIER 2/radio.wav.meta

# Abandoned CH4-Map1 FBX/USDZ detour + its scene/navmesh (superseded by Level3/PlacedObjects).
/Assets/Scenes/CH4-Map1.unity
/Assets/Scenes/CH4-Map1.unity.meta
/Assets/NavMeshData/CH4-Map1-NavMesh.asset
/Assets/NavMeshData/CH4-Map1-NavMesh.asset.meta
/Assets/_Project/Levels/
/Assets/_Project/Levels.meta
